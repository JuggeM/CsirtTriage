<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>CsirtTriage.Core</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
		<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SharpCompress" Version="0.47.4" />
		<PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
	</ItemGroup>
	<ItemGroup>
		<!-- Detection rules: a loose file next to the exe so analysts can edit it -->
		<None Update="rules.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
