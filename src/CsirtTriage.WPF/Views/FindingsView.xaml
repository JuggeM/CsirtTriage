<UserControl x:Class="CsirtTriage.WPF.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext set here: a binding on the view inside MainWindow's style never resolves -->
    <Grid DataContext="{Binding Findings}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Findings" Style="{StaticResource SectionTitle}"/>

        <!-- Filters, each with a label -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Search" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         ToolTip="Finds text in the finding, its detail and artifact: an IP, user, path, command…"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Severity (and higher)" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding MinSeverity}" Width="140"
                          ToolTip="Shows findings of this severity and higher"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                <TextBlock Text="Host" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding Host}" Width="130"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                <TextBlock Text="Source" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" Width="140"/>
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                <Button Content="Clear filters" Style="{StaticResource StandardButton}" Command="{Binding ClearFiltersCommand}"/>
                <Button Content="⟳ Reload" Style="{StaticResource StandardButton}" Command="{Binding RefreshCommand}" Margin="6,0,0,0"
                        ToolTip="Read the findings again from Level2\ (after a run they reload by themselves)"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}" BorderBrush="{StaticResource BorderBrush}"
                  Background="White" RowBackground="White" EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Severity" Width="82" SortMemberPath="Rank">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="CRITICAL"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="HIGH"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="MEDIUM"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TimeText}" Width="130"/>
                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="80"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100"/>
                <DataGridTextColumn Header="#" Binding="{Binding Count}" Width="40"/>
                <DataGridTextColumn Header="Finding" Binding="{Binding Text}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Detail of the selected finding -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,8,0,0" MaxHeight="150">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Selected.Text}" TextWrapping="Wrap" FontWeight="Medium" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Selected.Detail}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding Selected.Collection, Mode=OneWay}"/>
                        <Run Text="{Binding Selected.Kind, Mode=OneWay}"/>
                        <Run Text="{Binding Selected.Artifact, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
