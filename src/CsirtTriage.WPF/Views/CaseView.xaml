<UserControl x:Class="CsirtTriage.WPF.Views.CaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Case" Style="{StaticResource SectionTitle}"/>

        <!-- Case details on one row -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Case name" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding CaseName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Analyst" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Analyst, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Case folder" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding CaseFolder, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0"
                         ToolTip="Uploads\ (archives), Decompressed\ (extracted collections), Processed\ (KAPE output and UAC normalised CSVs); results go to Level2\"/>
                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource StandardButton}" Command="{Binding BrowseCommand}"/>
                <Button Grid.Column="2" Content="Open" Style="{StaticResource StandardButton}" Margin="8,0,0,0" Command="{Binding OpenCaseFolderCommand}"/>
            </Grid>

            <!-- Collections toolbar -->
            <Grid Margin="0,12,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Collections" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ScanStatus}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Not analysed yet" Style="{StaticResource StandardButton}" Command="{Binding SelectNewCommand}" Margin="0,0,6,0"
                            ToolTip="Tick every collection that hasn't been analysed (the default)"/>
                    <Button Content="All" Style="{StaticResource StandardButton}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"
                            ToolTip="Tick every collection that can run, including ones to re-analyse"/>
                    <Button Content="None" Style="{StaticResource StandardButton}" Command="{Binding SelectNoneCommand}" Margin="0,0,12,0"/>
                    <Button Content="⟳  Rescan" Style="{StaticResource StandardButton}" Command="{Binding RescanCommand}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Collections}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  BorderBrush="{StaticResource BorderBrush}" Background="White" RowBackground="White"
                  SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" MinHeight="160">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Run" Width="44" SortMemberPath="IsSelected">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="52" IsReadOnly="True"/>
                <DataGridTextColumn Header="Collection" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Collected" Binding="{Binding Collected}" Width="84" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Status" Width="1.4*" SortMemberPath="StatusLabel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Note}">
                                <TextBlock Text="{Binding StatusLabel}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="ok"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="busy"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="waiting"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="failed"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="0,2,0,0"
                                             Visibility="{Binding HasFraction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Will" Binding="{Binding ActionLabel}" Width="110" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="■" ToolTip="Cancel this collection; the others continue" Command="{Binding CancelCommand}"
                                    Padding="4,0" Margin="2" Style="{StaticResource StandardButton}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Windows collections are processed by the ORC script into Processed\ first; until then they show as waiting. Results go to Level2\&lt;collection&gt; (normalised UAC logs stay in Processed\). Re-analysing keeps the earlier results in Level2\_previous. Several collections run at the same time (Settings)."/>
    </Grid>
</UserControl>
