<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>CsirtTriage.WPF</RootNamespace>
		<AssemblyName>CsirtTriage</AssemblyName>
		<Version>0.1.0</Version>
		<!-- Lets the Windows-only project build on Linux/macOS too (compile check in any environment) -->
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\CsirtTriage.Core\CsirtTriage.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- WinForms is only used for the folder picker; keep WPF types unambiguous -->
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>
</Project>
